<?xml version="1.0" encoding="utf-8"?>
<!--
  Приложение ходит только в интернет по https (OLX API и страницы товаров).
  Открытый http запрещён, пользовательским сертификатам не доверяем.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
