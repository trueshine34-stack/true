<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView style="@style/Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Перерыв" />

    <TextView
        android:id="@+id/breakTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="Отдохни от стола"
        android:textColor="@color/text"
        android:textSize="24sp" />

    <FrameLayout
        android:layout_width="248dp"
        android:layout_height="248dp"
        android:layout_marginTop="28dp">

        <com.trueshine.pokertracker.RingView
            android:id="@+id/breakRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/breakTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:text="05:00"
                android:textColor="@color/text"
                android:textSize="58sp" />

            <TextView
                android:id="@+id/breakHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="сессия на паузе"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/breakStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/addMinBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:gravity="center"
            android:text="+1 мин"
            android:textColor="@color/text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/endBreakBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_primary"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Вернуться за стол"
            android:textColor="#FF241900"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
