# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
HOST=127.0.0.1
# URL-ul public (folosit în emailuri, sitemap, Open Graph). Fără slash la final.
PUBLIC_URL=http://localhost:8080
# production | development
NODE_ENV=development
# Secret pentru semnarea tokenurilor CSRF / cookie-uri. Generează: openssl rand -hex 32
APP_SECRET=
# Directorul pentru baza de date, emailuri de test și upload-uri
DATA_DIR=./var

# ── Administrator inițial (creat la primul start dacă nu există niciun admin) ─
ADMIN_EMAIL=admin@livada.ro
# Lasă gol în development → parola demo „Livada2026!”. În producție e obligatorie.
ADMIN_PASSWORD=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Fără SMTP_HOST, emailurile sunt salvate în var/outbox și pot fi văzute la /dev/mail
SMTP_HOST=
SMTP_PORT=587
# true = TLS implicit (port 465); false = STARTTLS (port 587)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Livada <comenzi@livada.ro>"
# Unde primește magazinul notificările de comenzi noi
SHOP_NOTIFY_EMAIL=comenzi@livada.ro

# ── Hartă lockere ────────────────────────────────────────────────────────────
# Implicit (variabile goale): dalele OpenStreetMap, afișate monocrom. Sunt gratuite, dar politica OSM
# nu permite trafic mare — pentru producție folosește un furnizor cu cheie API, de exemplu:
#   MapTiler:  https://api.maptiler.com/maps/dataviz/{z}/{x}/{y}{r}.png?key=CHEIA_TA
#   Stadia:    https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png?api_key=CHEIA_TA
#   CARTO:     https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png  (necesită cont CARTO)
# MAP_TILES_TONE=mono transformă orice hartă colorată în tonuri de gri (none = culorile originale).
MAP_TILES_URL=
MAP_TILES_ATTRIBUTION=
MAP_TILES_TONE=
