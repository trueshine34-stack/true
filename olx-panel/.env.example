# ── Panel ────────────────────────────────────────────────────────────────
PORT=8787
HOST=127.0.0.1
# Пароль-токен панели. Если пусто — панель открыта всем, кто дотянется до порта.
PANEL_TOKEN=

# ── OLX Partner API (https://developer.olx.pl) ───────────────────────────
# Ключи выдаются после регистрации приложения в кабинете разработчика OLX.
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
# Заполняется автоматически после подключения через OAuth в панели.
OLX_REFRESH_TOKEN=
OLX_SCOPE=v2 read write
OLX_BASE_URL=https://www.olx.pl/api/partner
OLX_TOKEN_URL=https://www.olx.pl/api/open/oauth/token

# ── Публикация ───────────────────────────────────────────────────────────
# Пауза между объявлениями, мс. Меньше 30 000 ставить не советую — лимиты API.
PUBLISH_INTERVAL_MS=45000
PUBLISH_MAX_PER_RUN=20
# 1 = только считать и форматировать, ничего не отправлять в OLX
PUBLISH_DRY_RUN=0

# ── Импорт ───────────────────────────────────────────────────────────────
IMPORT_TIMEOUT_MS=20000
